<Window x:Class="Kolora.Orcamentos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOLORA Gestor" Height="768" Width="1366" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" Icon="pack://application:,,,/Resources/kolora_logo.png">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2" Background="#1A1A2E">
            <StackPanel Margin="10">
                <!-- Logo KOLORA no canto superior esquerdo -->
                <Image Source="pack://application:,,,/Resources/kolora_logo.png"
                       Width="64" Height="64" Margin="0,10,0,4" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="KOLORA Gestor"/>
                <TextBlock Text="KOLORA" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,0"/>
                <TextBlock Text="Gestor Grafico" Foreground="#FF6B35" FontSize="11" Margin="0,0,0,20"/>
                <Button Content="Dashboard" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Dashboard" Click="Nav_Dashboard"/>
                <Button Content="Produtos" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Produtos" Click="Nav_Produtos"/>
                <Button Content="Materiais" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Materiais" Click="Nav_Materiais"/>
                <Button Content="Calculadora" Margin="0,4" Padding="10,8" Background="#FF6B35" Foreground="White" BorderThickness="0" x:Name="BtnNav_Calculadora" Click="Nav_Calculadora"/>
                <Button Content="Stock" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Stock" Click="Nav_Stock"/>
                <Button Content="Orcamentos" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Orcamentos" Click="Nav_Orcamentos"/>
                <Button Content="Clientes" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Clientes" Click="Nav_Clientes"/>
                <Button Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Pedidos" Click="Nav_Pedidos">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Pedidos"/><TextBlock x:Name="BadgePedidos" Text=" 0" Foreground="#FF6B35" FontWeight="Bold" Visibility="Collapsed"/></StackPanel>
                </Button>
                <Button Content="Configuracoes" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Config" Click="Nav_Config"/>
                <Button Content="Sobre" Margin="0,4" Padding="10,8" Background="#16213E" Foreground="White" BorderThickness="0" x:Name="BtnNav_Sobre" Click="Nav_Sobre"/>
            </StackPanel>
        </Border>
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="10"/>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#16213E" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="SyncText" Text="Sincronizado" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="KOLORA Gestor v1.0.0 | Offline-first" Foreground="#888" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
