<UserControl x:Class="Kolora.Orcamentos.Views.SobreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Sobre" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="KOLORA Gestor v1.0.0" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E"/>
                    <TextBlock Text="{Binding Info}" Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>
                    <TextBlock Text="{Binding Versao, StringFormat='Versão: {0}'}" Foreground="#888" FontSize="11" Margin="0,12,0,0"/>
                    <TextBlock Text="Stack: .NET 8 + WPF + SQLite WAL + EF Core + QuestPDF + Supabase + Serilog" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="Offline-first • Single-user • %AppData%/Kolora" Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
