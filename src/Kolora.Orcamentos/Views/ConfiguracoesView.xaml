<UserControl x:Class="Kolora.Orcamentos.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Configurações" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Gráfica" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Nome" FontSize="11" Foreground="#666"/><TextBox Text="{Binding NomeGrafica, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Telefone" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,8,0,0"><TextBlock Text="Localização" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Localizacao, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Logo (local)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding LogoPath}" IsReadOnly="True" Padding="6" Margin="0,2" Background="#F5F5F5"/></StackPanel>
                            <Button Grid.Column="1" Content="Escolher Logo" Command="{Binding EscolherLogoCommand}" Padding="12,6" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PDF &amp; Negócio" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Nome exibição no PDF" FontSize="11" Foreground="#666"/><TextBox Text="{Binding NomePdf, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Mensagem rodapé PDF" FontSize="11" Foreground="#666"/><TextBox Text="{Binding MensagemRodape, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Margem Global" FontSize="11" Foreground="#666"/><TextBox Text="{Binding MargemGlobal, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Validade (dias)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding ValidadeDias, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,8">
                            <TextBlock Text="Pagamentos (aparecem no PDF)" FontWeight="Bold" Foreground="#FF6B35" FontSize="12"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="IBAN" FontSize="11" Foreground="#666"/>
                                    <TextBox Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                                    <TextBlock Text="ex: AO06.0040.0000.1234.5678.9012.3" Foreground="#AAA" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nº Multicaixa Express (telefone/POS)" FontSize="11" Foreground="#666"/>
                                    <TextBox Text="{Binding MulticaixaExpress, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                                    <TextBlock Text="ex: +244 923 000 000" Foreground="#AAA" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,8">
                            <TextBlock Text="Supabase (sync opcional — backup na nuvem)" FontWeight="Bold" Foreground="#FF6B35" FontSize="12"/>
                            <TextBlock Text="A anon key é cifrada com o Windows (DPAPI) e só abre na sua conta. Copiada para outro PC não serve." Foreground="#888" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="URL do projeto" FontSize="11" Foreground="#666"/>
                                    <TextBox Text="{Binding SupabaseUrl, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                                    <TextBlock Text="ex: https://xxx.supabase.co" Foreground="#AAA" FontSize="9" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Anon key" FontSize="11" Foreground="#666"/>
                                    <TextBox Text="{Binding SupabaseKey, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Guardar key" Command="{Binding GuardarSupabaseAsyncCommand}" Background="#1A1A2E" Foreground="White" BorderThickness="0" Padding="12,8" VerticalAlignment="Bottom" Margin="0,0,6,0"/>
                                <Button Grid.Column="3" Content="Remover" Command="{Binding RemoverSupabaseCommand}" Padding="12,8" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Status: " FontSize="11" Foreground="#666"/>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="OFF — app 100% offline"/>
                                            <Setter Property="Foreground" Value="#888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SyncAtivo}" Value="True">
                                                    <Setter Property="Text" Value="ON — sync ativo"/>
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="16,8" FontWeight="Bold" Margin="0,0,8,0"/>
                    <Button Content="Backup (.zip)" Command="{Binding BackupCommand}" Padding="12,8" Margin="0,0,8,0"/>
                    <Button Content="Abrir Logs" Command="{Binding AbrirLogsCommand}" Padding="12,8" Margin="0,0,8,0"/>
                    <Button Content="Abrir Pasta Dados" Command="{Binding AbrirPastaDadosCommand}" Padding="12,8"/>
                </StackPanel>
                <TextBlock Text="{Binding Mensagem}" Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
