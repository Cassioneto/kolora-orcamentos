<UserControl x:Class="Kolora.Orcamentos.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Configurações" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Gráfica" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Nome" FontSize="11" Foreground="#666"/><TextBox Text="{Binding NomeGrafica, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Telefone" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,8,0,0"><TextBlock Text="Localização" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Localizacao, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Logo (local)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding LogoPath}" IsReadOnly="True" Padding="6" Margin="0,2" Background="#F5F5F5"/></StackPanel>
                            <Button Grid.Column="1" Content="Escolher Logo" Command="{Binding EscolherLogoCommand}" Padding="12,6" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PDF &amp; Negócio" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Nome exibição no PDF" FontSize="11" Foreground="#666"/><TextBox Text="{Binding NomePdf, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Mensagem rodapé PDF" FontSize="11" Foreground="#666"/><TextBox Text="{Binding MensagemRodape, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Margem Global" FontSize="11" Foreground="#666"/><TextBox Text="{Binding MargemGlobal, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Validade (dias)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding ValidadeDias, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="16,8" FontWeight="Bold" Margin="0,0,8,0"/>
                    <Button Content="Backup (.zip)" Command="{Binding BackupCommand}" Padding="12,8" Margin="0,0,8,0"/>
                    <Button Content="Abrir Logs" Command="{Binding AbrirLogsCommand}" Padding="12,8" Margin="0,0,8,0"/>
                    <Button Content="Abrir Pasta Dados" Command="{Binding AbrirPastaDadosCommand}" Padding="12,8"/>
                </StackPanel>
                <TextBlock Text="{Binding Mensagem}" Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
