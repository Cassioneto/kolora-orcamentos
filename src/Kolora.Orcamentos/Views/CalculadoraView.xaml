<UserControl x:Class="Kolora.Orcamentos.Views.CalculadoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Calculadora Universal" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <TextBlock Grid.Row="0" Text="Custo real + margem → preço final. Suporta M2, Unidade e MetroLinear." Foreground="#666"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Produto" FontSize="11" Foreground="#666"/><ComboBox ItemsSource="{Binding Produtos}" SelectedItem="{Binding ProdutoSelecionado}" DisplayMemberPath="Nome" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Largura (m)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Largura, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Altura (m)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Altura, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Qtd" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0"><TextBlock Text="Margem" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Margem, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#1A1A2E" CornerRadius="8" Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Detalhe}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Background="#FF6B35" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="CUSTO" Foreground="White" FontSize="10"/><TextBlock Text="{Binding CustoCalculado, StringFormat='Kz {0:N2}'}" Foreground="White" FontSize="16" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="6" Padding="12,8">
                        <StackPanel><TextBlock Text="PREÇO FINAL" Foreground="#1A1A2E" FontSize="10"/><TextBlock Text="{Binding PrecoCalculado, StringFormat='Kz {0:N2}'}" Foreground="#1A1A2E" FontSize="16" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Button Content="Limpar" Command="{Binding LimparCommand}" Margin="12,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Text="Dica: use esta calculadora para pré-visualizar antes de adicionar itens ao orçamento. O cálculo considera TipoCalculo do produto (M2 multiplica largura×altura×qtd)." Foreground="#888" FontSize="11" TextWrapping="Wrap"/>

        <!-- Aba Margem: calculadora de margem com explicacao -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="#FF6B35" BorderThickness="1" Margin="0,36,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Aba Margem — descubra a margem real" FontSize="15" FontWeight="Bold" Foreground="#1A1A2E"/>
                <TextBlock Text="Introduza o custo e o preço que você pensa cobrar. O app mostra a margem de verdade, a diferença entre margem sobre venda e markup sobre custo, e sugere preços." Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Custo (Kz)" FontSize="11" Foreground="#666"/>
                        <TextBox Text="{Binding MargemCustoInput, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Preço que você quer cobrar (Kz)" FontSize="11" Foreground="#666"/>
                        <TextBox Text="{Binding MargemPrecoInput, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="6" Padding="10,6" Margin="0,0,6,0" VerticalAlignment="Bottom">
                        <StackPanel><TextBlock Text="LUCRO" Foreground="#E65100" FontSize="9"/><TextBlock Text="{Binding MargemLucro, StringFormat='Kz {0:N2}'}" Foreground="#E65100" FontSize="14" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#1A1A2E" CornerRadius="6" Padding="10,6" Margin="0,0,6,0" VerticalAlignment="Bottom">
                        <StackPanel><TextBlock Text="MARGEM VENDA" Foreground="#FF6B35" FontSize="9"/><TextBlock Text="{Binding MargemVendaPct, StringFormat={}{0:P1}}" Foreground="#FF6B35" FontSize="14" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#E3F2FD" CornerRadius="6" Padding="10,6" VerticalAlignment="Bottom">
                        <StackPanel><TextBlock Text="MARKUP CUSTO" Foreground="#1565C0" FontSize="9"/><TextBlock Text="{Binding MarkupCustoPct, StringFormat={}{0:P1}}" Foreground="#1565C0" FontSize="14" FontWeight="Bold"/></StackPanel>
                    </Border>
                </Grid>

                <Button Content="Limpar" Command="{Binding LimparMargemCommand}" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="11"/>

                <!-- Explicacao detalhada -->
                <Border Background="#F5F5F5" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <TextBlock Text="{Binding MargemExplicacao}" Foreground="#444" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
                </Border>

                <!-- Sugestoes de preco -->
                <TextBlock Text="Preços sugeridos a partir do seu custo" FontWeight="Bold" FontSize="11" Foreground="#1A1A2E" Margin="0,10,0,4"/>
                <DataGrid ItemsSource="{Binding Sugestoes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" RowHeaderWidth="0" MaxHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Margem de venda" Binding="{Binding MargemVenda}" Width="110"/>
                        <DataGridTextColumn Header="Markup necessário" Binding="{Binding MarkupNecessario}" Width="110"/>
                        <DataGridTextColumn Header="Multiplicador" Binding="{Binding Multiplicador}" Width="90"/>
                        <DataGridTextColumn Header="Preço sugerido" Binding="{Binding PrecoSugerido}" Width="*"/>
                        <DataGridTextColumn Header="Lucro" Binding="{Binding Lucro}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Regra de bolso: margem de venda 40% = multiplicar o custo por ~1.67 (não por 1.40). Quem soma 40% em cima do custo fica só com 29% de venda." Foreground="#888" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
