<UserControl x:Class="Kolora.Orcamentos.Views.MateriaisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Materiais &amp; Stock" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Nome" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Unidade" FontSize="11" Foreground="#666"/><ComboBox ItemsSource="{Binding Unidades}" Text="{Binding Unidade}" IsEditable="True" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Stock Atual" FontSize="11" Foreground="#666"/><TextBox Text="{Binding StockAtual, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Stock Mínimo" FontSize="11" Foreground="#666"/><TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Novo" Command="{Binding NovoCommand}" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Materiais}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}" Width="90"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockAtual}" Width="90"/>
                <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StockAtual}" Width="90"/>
                <DataGridTemplateColumn Header="" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Margin="2" Padding="6,2" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Excluir" Margin="2" Padding="6,2" Background="#E53935" Foreground="White" BorderThickness="0" Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
