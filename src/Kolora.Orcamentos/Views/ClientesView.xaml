<UserControl x:Class="Kolora.Orcamentos.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Clientes" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Nome" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Telefone" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Novo" Command="{Binding NovoCommand}" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBox Grid.Row="2" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8">
            <TextBox.Style><Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#E0E0E0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Background" Value="#FFF8F0"/></Trigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Clientes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="160"/>
                <DataGridTextColumn Header="Criado" Binding="{Binding CriadoEm, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTemplateColumn Header="" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Margin="2" Padding="6,2" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Excluir" Margin="2" Padding="6,2" Background="#E53935" Foreground="White" BorderThickness="0" Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
