<UserControl x:Class="Kolora.Orcamentos.Views.OrcamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Orçamentos" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Cliente" FontSize="11" Foreground="#666"/>
                        <ComboBox ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSelecionado}" DisplayMemberPath="Nome" Margin="0,2">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Selecione o cliente"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Produto" FontSize="11" Foreground="#666"/><ComboBox ItemsSource="{Binding Produtos}" SelectedItem="{Binding ProdutoSelecionado}" DisplayMemberPath="Nome" Margin="0,2"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Largura" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Largura, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Altura" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Altura, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0"><TextBlock Text="Qtd" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ Adicionar Item" Command="{Binding AdicionarItemCommand}" Background="#1A1A2E" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Limpar Itens" Command="{Binding LimparItensCommand}" Padding="10,6" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Mensagem}" Foreground="#FF6B35" VerticalAlignment="Center" FontSize="11" Margin="8,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="#FFF8F0" CornerRadius="8" Padding="10" BorderBrush="#FF6B35" BorderThickness="1" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Itens do Orçamento" FontWeight="Bold" FontSize="11" Foreground="#1A1A2E" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="140" BorderBrush="#E0E0E0" BorderThickness="1" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80"/>
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Qtd}" Width="60"/>
                        <DataGridTextColumn Header="Medidas" Binding="{Binding Largura, StringFormat={}{0}x}" Width="80"/>
                        <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat='Kz {0:N2}'}" Width="110"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="✕" Padding="6,2" Background="#E53935" Foreground="White" BorderThickness="0" Command="{Binding DataContext.RemoverItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding Total, StringFormat='Total: Kz {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                    <Button Content="Salvar Orçamento + Gerar PDF" Command="{Binding SalvarOrcamentoCommand}" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="Bold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Text="Histórico" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,4,0,6"/>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Orcamentos}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Kz {0:N2}'}" Width="120"/>
                <DataGridTextColumn Header="Validade" Binding="{Binding Validade, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="PDF" Binding="{Binding CaminhoPdf, Converter={StaticResource FileNameConv}}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Abrir pasta" Margin="2" Padding="8,2" Command="{Binding DataContext.AbrirPastaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Excluir" Margin="2" Padding="8,2" Background="#E53935" Foreground="White" BorderThickness="0" Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
