<UserControl x:Class="Kolora.Orcamentos.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
            <TextBlock Text="{Binding GraficaNome, StringFormat='Gráfica: {0}'}" Foreground="#FF6B35" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,8,8">
                <StackPanel><TextBlock Text="Produtos Ativos" Foreground="#888" FontSize="11"/><TextBlock Text="{Binding TotalProdutos}" FontSize="28" FontWeight="Bold" Foreground="#1A1A2E"/><TextBlock Text="cadastrados" Foreground="#888" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,8,8">
                <StackPanel><TextBlock Text="Clientes" Foreground="#888" FontSize="11"/><TextBlock Text="{Binding TotalClientes}" FontSize="28" FontWeight="Bold" Foreground="#1A1A2E"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                <StackPanel><TextBlock Text="Orçamentos" Foreground="#888" FontSize="11"/><TextBlock Text="{Binding TotalOrcamentos}" FontSize="28" FontWeight="Bold" Foreground="#1A1A2E"/><TextBlock Text="{Binding FaturacaoMes, StringFormat='Faturação mês: {0:C}'}" Foreground="#2E7D32" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="#FFF3E0" CornerRadius="8" Padding="16" BorderBrush="#FF6B35" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="⚠️ Stock Crítico" Foreground="#E65100" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding StockCritico}" FontSize="28" FontWeight="Bold" Foreground="#E65100"/><TextBlock Text="materiais abaixo do mínimo" Foreground="#888" FontSize="11"/></StackPanel>
            </Border>
            <Border Background="#E8F5E9" CornerRadius="8" Padding="16" BorderBrush="#4CAF50" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="🔔 Pedidos Novos" Foreground="#2E7D32" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding PedidosNovos}" FontSize="28" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel>
            </Border>
            <Border Background="#E3F2FD" CornerRadius="8" Padding="16" BorderBrush="#1976D2" BorderThickness="1" Margin="0,0,0,0">
                <StackPanel><TextBlock Text="Sync" Foreground="#1565C0" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding PendentesSync}" FontSize="28" FontWeight="Bold" Foreground="#1565C0"/><TextBlock Text="pendentes Outbox" Foreground="#888" FontSize="11"/></StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Atalhos piloto offline" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,8"/>
                <TextBlock Text="1. Cadastre Produtos (M2/Unidade/MetroLinear) e Materiais com stock&#x0a;2. Use a Calculadora para validar custo/margem&#x0a;3. Crie um Orçamento (cliente + itens) → PDF em Documentos/Kolora/Orcamentos + abate stock&#x0a;4. Desligue a internet, crie 10 orçamentos, religue — todos sincronizam sozinhos" Foreground="#555" TextWrapping="Wrap" LineHeight="18"/>
                <Button Content="↻ Atualizar" Command="{Binding LoadCommand}" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
