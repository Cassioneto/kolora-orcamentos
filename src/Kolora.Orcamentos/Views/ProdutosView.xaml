<UserControl x:Class="Kolora.Orcamentos.Views.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Produtos" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
        <TextBlock Grid.Row="0" Text="Cadastro genérico — DTF, lona, vinil, cartão, sublimação" Foreground="#666"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Nome" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Tipo Cálculo" FontSize="11" Foreground="#666"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoCalculo}" Margin="0,2"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Custo Base (Kz)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding PrecoCusto, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Margem (0.40)" FontSize="11" Foreground="#666"/><TextBox Text="{Binding Margem, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,2"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <CheckBox Content="Ativo" IsChecked="{Binding Ativo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Limpar" Command="{Binding LimparCommand}" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="Salvar" Command="{Binding SalvarCommand}" Background="#FF6B35" Foreground="White" BorderThickness="0" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Produtos}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoCalculo}" Width="100"/>
                <DataGridTextColumn Header="Custo" Binding="{Binding PrecoCustoBase, StringFormat='Kz {0:N2}'}" Width="110"/>
                <DataGridTextColumn Header="Margem" Binding="{Binding MargemPadrao, StringFormat=P0}" Width="80"/>
                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="60"/>
                <DataGridTemplateColumn Header="" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Margin="2" Padding="6,2" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Excluir" Margin="2" Padding="6,2" Background="#E53935" Foreground="White" BorderThickness="0" Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
