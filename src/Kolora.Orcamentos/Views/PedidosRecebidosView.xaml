<UserControl x:Class="Kolora.Orcamentos.Views.PedidosRecebidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Pedidos Recebidos (Inbox)" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
            <TextBlock Text="Pull do Supabase a cada 15-30s quando online. Badge 🔔 + Converter em Orçamento." Foreground="#666" Margin="0,2,0,0"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding Selecionado}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,0" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="140"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding ClienteTelefone}" Width="120"/>
                <DataGridTextColumn Header="Produto Desejado" Binding="{Binding ProdutoDesejado}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Criado" Binding="{Binding CriadoEmOrigem, StringFormat=dd/MM HH:mm}" Width="110"/>
                <DataGridTextColumn Header="Pedido" Binding="{Binding DescricaoPedido}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Visto" Padding="6,2" Margin="2" Command="{Binding DataContext.MarcarVistoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="Expirar" Padding="6,2" Margin="2" Background="#888" Foreground="White" BorderThickness="0" Command="{Binding DataContext.ExpirarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
